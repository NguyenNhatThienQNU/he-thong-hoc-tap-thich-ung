# =============================================================
#  Cấu hình AI Gợi Mở – hệ thống hỗ trợ học tập thích ứng bằng AI
#  Sao chép tệp này thành ".env" rồi điền các giá trị cần thiết.
#  (run.bat tự tạo .env ở lần chạy đầu)
# =============================================================

# Tên hiển thị trên giao diện
APP_NAME=AI Gợi Mở

# Địa chỉ học sinh truy cập được tới máy chủ (in trên mã QR của phiếu đăng nhập).
# Chạy trong phòng máy: ghi địa chỉ IP của máy giáo viên, ví dụ http://192.168.1.10:8000
PUBLIC_BASE_URL=http://localhost:8000

# Múi giờ hiển thị
TIMEZONE=Asia/Ho_Chi_Minh

# Cho phép tự đăng ký thêm tài khoản giáo viên (tài khoản đầu tiên luôn được tạo)
ALLOW_REGISTRATION=false

# CSDL: để trống = SQLite tại data/app.db. Ví dụ PostgreSQL (cần cài thêm: pip install "psycopg[binary]"):
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/goimo
DATABASE_URL=

# Khóa ký phiên đăng nhập: để trống = tự sinh và lưu ở data/.secret_key
SECRET_KEY=

# ---------------- AI (Google Gemini) ----------------
# Lấy khóa miễn phí tại https://aistudio.google.com/apikey
# Để trống = CHẾ ĐỘ DEMO (gợi ý dựng theo luật từ lời giải mẫu và tài liệu đã duyệt)
GEMINI_API_KEY=
# Bí danh luôn trỏ tới mô hình Flash mới nhất; có thể ghi tên cụ thể để cố định phiên bản khi chạy thực nghiệm
GEMINI_MODEL=gemini-flash-latest
# auto | gemini | mock
AI_PROVIDER=auto

# Dung lượng tối đa của tệp tài liệu tải lên (MB)
MAX_UPLOAD_MB=15
